# Normalise line endings: LF in the repo and working tree, so Windows and WSL tools agree.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.iss   text eol=crlf

# Binary assets.
*.pdf   binary
*.png   binary
*.jpg   binary
*.otf   binary
*.ttf   binary
*.docx  binary
